{
  "data_dir": "data",
  "output_dir": "outputs/preprocessing",
  "chunksize": 25000,
  "folds_path": "configs/folds.csv",
  "preprocessing": {
    "length_quantile": 0.95,
    "sample_period_seconds": null,
    "gravity": 9.80665,
    "quaternion_direction": "device_to_world",
    "canonical_hand": 1,
    "sensor_permutation": [
      0,
      1,
      4,
      3,
      2
    ],
    "tof_base_rot90": [
      0,
      0,
      0,
      0,
      0
    ],
    "tof_mirror": [
      "lr",
      "lr",
      "lr",
      "lr",
      "lr"
    ],
    "tof_normalization": "standard",
    "imu_dynamics": true
  },
  "sensor_dropout": {
    "rotation_probability": 0.05,
    "thm_probability": 0.1,
    "tof_probability": 0.1,
    "channel_probability": 0.03
  }
}
